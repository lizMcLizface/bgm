  "rules": [
    "Tail eligibility NEVER changes output connectivity",
    "Explicit canonical retire(frame,remainingMask,epoch) atomically validates all removed stages",
    "Retire requires eligible stage and retired predecessor, with input-inactive authority for shaper",
    "Only masks7,6,4,0 represent this fixed serial chain",
    "Explicit activate uses a strictly newer nonzero u32 epoch, preserves DSP and parameter history",
    "Stale epoch, changed edit frame, active input under a retired chain and malformed authority fail closed",
    "No future queue/cancellation or timestamp rebasing; next begin must use the exact authored edit frame",
    "Whole-route demand is separate from stage output retirement",
    "Connected Delay parameter-only processing continues all four oscillator/depth clocks"
  ],
  "sourceCopyTransforms": [
    "Remove allocation-audit module hook only",
    "Add Clone,Copy derivation to value-only Lifecycle state for zero-heap transactional validation"
  ],
  "queueRules": [
    "Canonical future frames at/after next callback; chronologically authored order including same-frame order",
    "Sequence1..16777215 never wraps",
    "Projected epoch/output-mask validation before queue admission",
    "Late queued event rejects before policy mutation, dequeue or observed ACK",
    "All same-frame events plus input/demand authority validate on a stack policy copy",
    "No earlier insertion or cancellation in this first component contract"
  ]
}
