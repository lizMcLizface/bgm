{
  "name": "bgm",
  "private": true,
  "version": "0.1.0",
  "description": "Calm procedural background music in the browser",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run synth:check && npm run synths:check && npm run graph:check && npm run core-live:check && npm run ambience-host:check && npm run piano:check && npm run iowa:check && npm run mixer:check && npm run rack-fx:check && npm run voice-fx:check && npm run motion:check && npm run tape:check && npm run plucked:check && npm run plucked-voice:check && npm run weather:check && npm run string-preparation:check && npm run native-compressor:check && npm run string-voice:check && npm run native-compressor-automation:check && npm run convolver:check && npm run ambience-loops:check && npm run string-decay:check && npm run convolver-preparation:check && npm run room-colour:check && npm run iowa-live:check && npm run voice-compressor:check && npm run piano-live:check && npm run voice-compressor-live:check && npm run ensemble:check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "graph:build": "node tools/buildModularAudio.mjs",
    "ensemble:fixture": "vite-node tools/buildSixRoleFixture.mjs",
    "ensemble:check": "vite-node tools/buildSixRoleFixture.mjs --check",
    "ensemble:baseline": "vite-node tools/measureSixRoleKernels.mjs",
    "graph:check": "node tools/buildModularAudio.mjs --check",
    "graph:test": "node tools/buildModularAudio.mjs --test",
    "graph:render": "node tools/renderModularAudio.mjs",
    "graph:audit-alloc": "node tools/auditModularAlloc.mjs",
    "graph:audit-compressor": "node tools/auditModularAlloc.mjs && node tools/auditModularCompressor.mjs",
    "graph:audit-legacy": "node tools/auditPercussionOwned.mjs",
    "graph:audit-dag": "vite-node tools/auditPitchedDag.mjs",
    "graph:audit-iowa": "vite-node tools/auditIowa.mjs",
    "graph:audit-iowa-alloc": "node tools/auditModularAlloc.mjs && vite-node tools/auditIowaAlloc.mjs",
    "graph:audit-dag-alloc": "node tools/auditModularAlloc.mjs && vite-node tools/auditDagAlloc.mjs",
    "graph:audit-core": "vite-node tools/auditCoreOwned.mjs",
    "graph:audit-fm": "vite-node tools/auditFmOwned.mjs",
    "synth:build": "node tools/buildSynth.mjs",
    "synth:check": "node tools/buildSynth.mjs --check",
    "synth:profile-build": "node tools/buildSynthProfile.mjs",
    "levels:measure": "node tools/measureLevels.mjs",
    "audit:synth-profile": "node tools/profileSynth.mjs",
    "audit:worklet-profile": "node tools/profileWorklet.mjs",
    "audit:playback-profile": "node tools/profilePlayback.mjs",
    "audit:synth-simd": "node tools/auditSynthSimd.mjs",
    "synth:stage-build": "node tools/buildSynthProfile.mjs --sections && node tools/buildSubtractiveStages.mjs && node tools/buildSubtractiveStages.mjs --unused-sub",
    "test:synth-stages": "npm run synth:stage-build && vitest run src/synth-lab/subtractiveStages.test.js",
    "synth:bank-build": "node tools/buildFMBank.mjs",
    "audit:synth-bank": "node tools/auditFMBank.mjs",
    "audit:bank-playback": "node tools/auditFMBankPlayback.mjs",
    "audit:perf-mode": "node tools/auditPerfMode.mjs",
    "audit:synth-colour": "node tools/auditColourSimd.mjs",
    "audit:bank-ui": "node tools/auditFMBankUI.mjs",
    "test:synth-bank": "npm run synth:check && node tools/buildFMBank.mjs && vitest run src/synth-lab/fmBank.test.js src/synth-lab/fmBankPool.test.js",
    "test:synth-simd": "node tools/buildSynthProfile.mjs --simd && vitest run src/synth-lab/simd.test.js",
    "audit:wasm-playback": "node tools/auditWasmPlayback.mjs",
    "audit:synth-stress": "node tools/auditSynthStress.mjs",
    "audit:synth-ensemble": "node tools/auditSynthEnsemble.mjs",
    "audit:synth-spectrum": "node tools/auditSynthSpectrum.mjs",
    "audit:composition": "vitest run --config tools/vitest.audit.config.js tools/compositionAudit.audit.js",
    "survey:generate": "vitest run --config tools/vitest.audit.config.js tools/generatorSurvey.audit.js",
    "survey:analyze": "vite-node tools/generatorSurvey.mjs",
    "survey:chords": "vite-node tools/chordSurvey.mjs",
    "audit:rng": "vitest run --config tools/vitest.audit.config.js tools/rngAudit.audit.js",
    "audit:push": "vitest run --config tools/vitest.audit.config.js tools/pushFeel.audit.js",
    "audit:mood": "vitest run --config tools/vitest.audit.config.js tools/moodChords.audit.js",
    "audit:percussion": "node tools/auditPercussionEngine.mjs",
    "audit:percussion-playback": "node tools/auditPercussionPlayback.mjs",
    "audit:percussion-palette": "node tools/auditPercussionPalette.mjs",
    "audit:percussion-presets": "node tools/auditPercussionPresets.mjs",
    "audit:synth-tone": "node tools/auditSynthTone.mjs",
    "audit:phase4": "node tools/runPhase4Audit.mjs",
    "build:public": "npm run synth:check && npm run synths:check && npm run graph:check && npm run core-live:check && npm run ambience-host:check && npm run piano:check && npm run iowa:check && npm run mixer:check && npm run rack-fx:check && npm run voice-fx:check && npm run motion:check && npm run tape:check && npm run plucked:check && npm run plucked-voice:check && npm run weather:check && npm run string-preparation:check && npm run native-compressor:check && npm run string-voice:check && npm run native-compressor-automation:check && npm run convolver:check && npm run ambience-loops:check && npm run string-decay:check && npm run convolver-preparation:check && npm run room-colour:check && npm run iowa-live:check && npm run voice-compressor:check && npm run piano-live:check && npm run voice-compressor-live:check && npm run ensemble:check && vite build --mode public && node tools/checkPublicBuild.mjs",
    "predeploy": "npm test && npm run build:public",
    "deploy": "node tools/checkPublicBuild.mjs && gh-pages -d dist-public --dotfiles",
    "render": "vite-node tools/render.js --",
    "synths:build": "node tools/buildClassics.mjs",
    "synths:check": "node tools/buildClassics.mjs --check",
    "synths:presets": "vite-node tools/buildSynthPresets.mjs",
    "audit:synths": "vite-node tools/auditClassics.mjs",
    "vst:match": "vite-node tools/vstMatch.mjs --",
    "vst:mod": "vite-node tools/vstMod.mjs --",
    "audit:synth-reference": "npm run synths:check && vite-node tools/matchSynthReference.mjs",
    "graph:audit-worker": "vite-node tools/auditGraphWorker.mjs",
    "graph:audit-pool": "vite-node tools/auditGraphPool.mjs",
    "graph:audit-pool-alloc": "vite-node tools/auditGraphPoolAlloc.mjs",
    "graph:audit-profiles": "vite-node tools/auditGraphProfiles.mjs",
    "piano:build": "node tools/buildPiano.mjs",
    "piano:check": "node tools/buildPiano.mjs --check",
    "piano:audit": "vite-node tools/auditPiano.mjs",
    "piano:audit-measured": "vite-node tools/auditMeasuredPiano.mjs",
    "piano:tables": "node tools/buildPianoTables.mjs",
    "iowa:build": "node tools/buildIowaPreparation.mjs",
    "iowa:check": "node tools/buildIowaPreparation.mjs --check",
    "iowa:audit": "vite-node tools/auditIowaPreparation.mjs",
    "mixer:build": "node tools/buildOwnedMixer.mjs",
    "mixer:check": "node tools/buildOwnedMixer.mjs --check",
    "rack-fx:build": "node tools/buildOwnedRackFx.mjs --publish",
    "rack-fx:check": "node tools/buildOwnedRackFx.mjs --publish --check",
    "voice-fx:build": "node tools/buildOwnedVoiceFx.mjs --publish",
    "voice-fx:check": "node tools/buildOwnedVoiceFx.mjs --publish --check",
    "plucked-voice:build": "node tools/buildOwnedPluckedVoice.mjs --publish",
    "plucked-voice:check": "node tools/buildOwnedPluckedVoice.mjs --publish --check",
    "plucked:build": "node tools/buildOwnedPluckedString.mjs --publish",
    "plucked:check": "node tools/buildOwnedPluckedString.mjs --publish --check",
    "motion:build": "node tools/buildOwnedMotion.mjs --publish",
    "motion:check": "node tools/buildOwnedMotion.mjs --publish --check",
    "string-preparation:build": "node tools/buildStringPreparation.mjs --publish",
    "string-preparation:check": "node tools/buildStringPreparation.mjs --publish --check",
    "native-compressor:build": "node tools/buildOwnedNativeCompressor.mjs --publish",
    "native-compressor:check": "node tools/buildOwnedNativeCompressor.mjs --publish --check",
    "weather:build": "node tools/buildOwnedWeatherBed.mjs --publish",
    "weather:check": "node tools/buildOwnedWeatherBed.mjs --publish --check",
    "tape:build": "node tools/buildOwnedTape.mjs --publish",
    "tape:check": "node tools/buildOwnedTape.mjs --publish --check",
    "string-voice:build": "node tools/buildOwnedStringVoice.mjs --publish",
    "string-voice:check": "node tools/buildOwnedStringVoice.mjs --publish --check && node tools/buildStringNativeReference.mjs --check",
    "native-compressor-automation:build": "node tools/buildOwnedNativeCompressorAutomation.mjs --publish",
    "native-compressor-automation:check": "node tools/buildOwnedNativeCompressorAutomation.mjs --publish --check",
    "convolver:build": "node tools/buildOwnedConvolver.mjs --publish",
    "convolver:check": "node tools/buildOwnedConvolver.mjs --publish --check",
    "ambience-loops:build": "node tools/buildOwnedAmbienceLoops.mjs --publish",
    "ambience-loops:check": "node tools/buildOwnedAmbienceLoops.mjs --publish --check",
    "string-decay:build": "node tools/buildOwnedStringDecay.mjs --publish",
    "string-decay:check": "node tools/buildOwnedStringDecay.mjs --publish --check",
    "convolver-preparation:build": "node tools/buildConvolverPreparation.mjs --publish",
    "convolver-preparation:check": "node tools/buildConvolverPreparation.mjs --publish --check",
    "room-colour:build": "node tools/buildRoomColour.mjs --publish",
    "room-colour:check": "node tools/buildRoomColour.mjs --publish --check",
    "iowa-live:build": "node tools/buildIowaLive.mjs --publish && node tools/buildIowaLiveReference.mjs",
    "iowa-live:check": "node tools/buildIowaLive.mjs --publish --check && node tools/buildIowaLiveReference.mjs --check",
    "voice-compressor:build": "node tools/buildOwnedVoiceCompressor.mjs --publish",
    "voice-compressor:check": "node tools/buildOwnedVoiceCompressor.mjs --publish --check",
    "piano-live:build": "node tools/buildPianoLive.mjs --publish",
    "piano-live:check": "node tools/buildPianoLive.mjs --publish --check",
    "voice-compressor-live:build": "node tools/buildOwnedLiveVoiceCompressor.mjs --publish",
    "voice-compressor-live:check": "node tools/buildOwnedLiveVoiceCompressor.mjs --publish --check",
    "core-live:build": "node tools/buildOwnedCoreLive.mjs",
    "patch-transition:audit": "node tools/auditPatchTransition.mjs",
    "ambience-host:check": "node tools/buildOwnedAmbienceHost.mjs --check",
    "core-live:check": "node tools/buildOwnedCoreLive.mjs --check"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.6.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.14.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
