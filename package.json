{
  "name": "bgm",
  "private": true,
  "version": "0.1.0",
  "description": "Calm procedural background music in the browser",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run synth:check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "synth:build": "node tools/buildSynth.mjs",
    "synth:check": "node tools/buildSynth.mjs --check",
    "synth:profile-build": "node tools/buildSynthProfile.mjs",
    "audit:synth-profile": "node tools/profileSynth.mjs",
    "audit:synth-stress": "node tools/auditSynthStress.mjs",
    "audit:synth-ensemble": "node tools/auditSynthEnsemble.mjs",
    "audit:synth-spectrum": "node tools/auditSynthSpectrum.mjs",
    "audit:synth-tone": "node tools/auditSynthTone.mjs",
    "audit:phase4": "node tools/runPhase4Audit.mjs",
    "predeploy": "npm test && npm run build",
    "deploy": "gh-pages -d dist --dotfiles",
    "render": "vite-node tools/render.js --"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.14.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
