  "rules": [
    "Native strict f64 lastNonSilent+latency+tail < frame/rate",
    "lastNonSilent updated only after nonsilent input block",
    "shaper latency128/tail0; lowpass initialTailInfinity then last body coefficient; delay maxTail.02",
    "connected delay params-only pulls all four oscillator/depth graphs",
    "explicit whole-output unpulled freezes all nodes",
    "Input active connection and bus silence are distinct typed authorities",
    "Inactive-source output disable cascades through each tail; disabled Delay stops LFO pulls",
    "New active input connection re-enables the chain without resetting parameter history"
  ]
