    "upstreamPath": "synth-engine/piano-live/src/live_timeline.rs",
    "upstreamSHA256NormalizedLF": "9cb7d8d92254c50d7887533b76e0a0098b36e293a834f67c5229c47d36ce9930",
    "localPath": "src/timeline.rs",
    "scope": "Keeps original f64 seconds/timeConstants plus derived mixed-unit frame positions. Native HandleFirstEvent/HasSampleAccurateValues/fresh clamp compare seconds; segment endpoints and IsEventCurrent retain native frame-product comparisons. RemoveOldEvents always retains at least the last event, including in HandleAllEventsInThePast; a later target therefore preserves the native preceding-segment ceil boundary."
  },
  "motionConstructor": "depth gain0,pan gain0,tremolo frequency4,pan frequency0.2 are four intrinsic property updates plus four original-time Native step events; two subsequent separate oscillator.start() times. GainHandler stereo upmix occurs before split.",
  "nativeSourceActivity": "Direct original48k12case proof with an independent Native program-source capture branch: whole-stage disconnected clocks freeze. WaveShaper nonzero-at-zero tail does not imply a disconnected Motion graph remains pulled. No LFO/control taps.",
  "balanceResources": "Original1025point JavaScript balanceCurve evaluated without modification into little-endian Float32 resources; actual Native browser original curves must match both hashes.",
  "numericScope": "Pinned upstream source and empirical browser comparison with fixed bounds; not identity with arbitrary Chromium/ARM builds."
